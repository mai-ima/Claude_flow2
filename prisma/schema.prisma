// Tsumiki — 家計簿 + サブスク管理
// PostgreSQL を使用（Vercel/Neon 等。DATABASE_URL で接続）。
// 列挙値は String + アプリ層(Zod/TS union)で担保（DB 非依存・移行容易）。

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 認証 (Auth.js 互換スキーマ — 将来の移行を見据える)
// ─────────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  isAdmin          Boolean   @default(false)
  // 設定
  locale           String    @default("ja")
  currency         String    @default("JPY")
  themePref        String    @default("system") // system | light | dark
  assumedHourlyWage Int?     // コストタイム用の想定時給(円)
  betaOptIn        Boolean   @default(false) // ベータ機能の親スイッチ
  // 個別に有効化したベータ機能のキー配列。
  // null = 未設定（betaOptIn が真なら全て有効／既存ユーザーの挙動を維持）
  // 配列 = ここに載っているものだけ有効
  betaFeatures     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     LedgerMember[]
  ownedLedgers    Ledger[]        @relation("LedgerOwner")
  createdTxns     Transaction[]   @relation("TxnCreatedBy")
  recurringTxns   RecurringTransaction[] @relation("RecurringCreatedBy")
  ownedSubs       Subscription[]  @relation("SubOwner")
  billing         BillingProfile?
  notifications   Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// 帳簿(データ所有境界) — 複数帳簿・ファミリー共有の土台
// ─────────────────────────────────────────────
model Ledger {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("PERSONAL") // PERSONAL | POD
  currency  String   @default("JPY")
  ownerId   String
  owner     User     @relation("LedgerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        LedgerMember[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  goals          Goal[]
  recurringTransactions RecurringTransaction[]

  @@index([ownerId])
}

model LedgerMember {
  id        String   @id @default(cuid())
  ledgerId  String
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("OWNER") // OWNER | EDITOR | VIEWER
  createdAt DateTime @default(now())

  @@unique([ledgerId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// 決済手段 — サブスク・スタックの土台
// ─────────────────────────────────────────────
model PaymentMethod {
  id        String   @id @default(cuid())
  ledgerId  String
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("CARD") // CARD | BANK | CASH | EMONEY
  brand     String?
  last4     String?
  color     String   @default("blue")
  icon      String   @default("card")
  createdAt DateTime @default(now())

  transactions  Transaction[]
  subscriptions Subscription[]
  recurringTransactions RecurringTransaction[]

  @@index([ledgerId])
}

// ─────────────────────────────────────────────
// 家計簿ドメイン
// ─────────────────────────────────────────────
model Category {
  id         String   @id @default(cuid())
  ledgerId   String
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  name       String
  type       String // INCOME | EXPENSE
  icon       String   @default("tag")
  color      String   @default("gray")
  parentId   String?
  parent     Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CatTree")
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())

  transactions Transaction[]
  budgets      Budget[]
  subscriptions Subscription[]
  recurringTransactions RecurringTransaction[]

  @@index([ledgerId, type])
}

model Transaction {
  id              String   @id @default(cuid())
  ledgerId        String
  ledger          Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  // 記録者が退会しても記録自体は帳簿に残す。Cascade のままだと共有帳簿で
  // 「他のメンバーが退会したら自分の家計簿から過去の記録が消える」ことになる。
  createdByUserId String?
  createdBy       User?    @relation("TxnCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  type            String // INCOME | EXPENSE
  amount          Int // 最小単位(JPY=円)
  currency        String   @default("JPY")
  occurredAt      DateTime
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  subscriptionId  String?
  subscription    Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  memo            String?
  createdAt       DateTime @default(now())

  @@index([ledgerId, occurredAt])
  @@index([ledgerId, categoryId])
  @@index([subscriptionId])
  @@index([recurringTransactionId])
}

// 繰り返し（定期）取引テンプレート。cron で nextRunAt 到来分を Transaction に自動生成。
model RecurringTransaction {
  id              String   @id @default(cuid())
  ledgerId        String
  ledger          Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?    @relation("RecurringCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  type            String // INCOME | EXPENSE
  amount          Int
  currency        String   @default("JPY")
  cycle           String   @default("MONTHLY") // MONTHLY | YEARLY | WEEKLY | QUARTERLY
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  memo            String?
  active          Boolean  @default(true)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions Transaction[]

  @@index([ledgerId, active])
  @@index([nextRunAt])
}

model Budget {
  id            String   @id @default(cuid())
  ledgerId      String
  ledger        Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isTotalBudget Boolean  @default(false)
  period        String   @default("MONTHLY") // MONTHLY | YEARLY
  amount        Int
  currency      String   @default("JPY")
  startMonth    DateTime
  createdAt     DateTime @default(now())

  // カテゴリ予算の一意性。全体予算(isTotalBudget=true, categoryId=null)が
  // 各帳簿で1件であることはアプリ層(upsert by lookup)で担保する。
  @@unique([ledgerId, categoryId, period, startMonth])
  @@index([ledgerId])
}

model Subscription {
  id                  String   @id @default(cuid())
  ledgerId            String
  ledger              Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ownerUserId         String?
  owner               User?    @relation("SubOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  name                String
  amount              Int
  currency            String   @default("JPY")
  cycle               String   @default("MONTHLY") // MONTHLY | YEARLY | WEEKLY | QUARTERLY
  status              String   @default("ACTIVE")  // ACTIVE | PAUSED | CANCELED | TRIAL
  nextRenewalAt       DateTime
  startedAt           DateTime?
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId     String?
  paymentMethod       PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  reminderDaysBefore  Int      @default(3)
  autoPostTransaction Boolean  @default(true)
  lastUsedAt          DateTime?
  lastReviewedAt      DateTime?
  trialEndsAt         DateTime? // status=TRIAL の終了予定日
  serviceKey          String?  // lib/service-catalog.ts のキー
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions  Transaction[]
  priceChanges  SubscriptionPriceChange[]

  @@index([ledgerId, nextRenewalAt])
  @@index([ledgerId, status])
}

// サブスクの価格改定履歴。amount 変更時に記録し、値上げ表示・履歴に用いる。
model SubscriptionPriceChange {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  oldAmount      Int
  newAmount      Int
  changedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, changedAt])
}

// ─────────────────────────────────────────────
// 貯金目標
// ─────────────────────────────────────────────
model Goal {
  id            String    @id @default(cuid())
  ledgerId      String
  ledger        Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Int
  currentAmount Int       @default(0)
  currency      String    @default("JPY")
  deadline      DateTime?
  color         String    @default("blue")
  icon          String    @default("target")
  // 自動積立（毎月）。amount と day が両方設定されると有効。
  autoContributionAmount Int?
  autoContributionDay    Int?      // 1-28
  nextAutoContributionAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contributions GoalContribution[]

  @@index([ledgerId])
  @@index([nextAutoContributionAt])
}

// 貯金目標の積立履歴。手動 / 自動の各積立を1行で記録。
model GoalContribution {
  id         String   @id @default(cuid())
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount     Int // 正=積立, 負=引き出し
  occurredAt DateTime @default(now())
  note       String?
  auto       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([goalId, occurredAt])
}

// ─────────────────────────────────────────────
// アプリ内通知
// ─────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerId  String?
  type      String // RENEWAL | SUMMARY | WASTE | SYSTEM | RECURRING | GOAL | BUDGET | PRICE_CHANGE | TRIAL_END
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// 収益化
// ─────────────────────────────────────────────
model BillingProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  tier                 String    @default("FREE") // FREE | PLUS | PRO
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @updatedAt
}
