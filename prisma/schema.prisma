// Tsumiki — 家計簿 + サブスク管理
// PostgreSQL を使用（Vercel/Neon 等。DATABASE_URL で接続）。
// 列挙値は String + アプリ層(Zod/TS union)で担保（DB 非依存・移行容易）。

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 認証 (Auth.js 互換スキーマ — 将来の移行を見据える)
// ─────────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  isAdmin          Boolean   @default(false)
  // 管理権限の粒度。isAdmin は後方互換で残し、adminRole != NONE と同期させる。
  // NONE | READONLY | SUPPORT | SUPER
  adminRole        String    @default("NONE")
  // 凍結。不正利用への対応が「削除」しか無い状態を避ける。
  // 凍結中はログインできず、既存セッションも破棄する。
  suspendedAt      DateTime?
  suspendedReason  String?
  // 設定
  locale           String    @default("ja")
  currency         String    @default("JPY")
  themePref        String    @default("system") // system | light | dark
  assumedHourlyWage Int?     // コストタイム用の想定時給(円)
  betaOptIn        Boolean   @default(false) // ベータ機能の親スイッチ
  // 個別に有効化したベータ機能のキー配列。
  // null = 未設定（betaOptIn が真なら全て有効／既存ユーザーの挙動を維持）
  // 配列 = ここに載っているものだけ有効
  betaFeatures     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     LedgerMember[]
  ownedLedgers    Ledger[]        @relation("LedgerOwner")
  createdTxns     Transaction[]   @relation("TxnCreatedBy")
  recurringTxns   RecurringTransaction[] @relation("RecurringCreatedBy")
  ownedSubs       Subscription[]  @relation("SubOwner")
  billing         BillingProfile?
  notifications   Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  // ログイン中の端末一覧と、身に覚えのないログインの検知に使う。
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  // 管理者が対象ユーザーとして閲覧している場合、その管理者のID。
  // 値が入っているセッションは読み取り専用として扱う。
  impersonatedBy String?

  @@index([userId, lastUsedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// 帳簿(データ所有境界) — 複数帳簿・ファミリー共有の土台
// ─────────────────────────────────────────────
model Ledger {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("PERSONAL") // PERSONAL | POD
  currency  String   @default("JPY")
  ownerId   String
  owner     User     @relation("LedgerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        LedgerMember[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  goals          Goal[]
  recurringTransactions RecurringTransaction[]

  @@index([ownerId])
}

model LedgerMember {
  id        String   @id @default(cuid())
  ledgerId  String
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("OWNER") // OWNER | EDITOR | VIEWER
  createdAt DateTime @default(now())

  @@unique([ledgerId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// 決済手段 — サブスク・スタックの土台
// ─────────────────────────────────────────────
model PaymentMethod {
  id        String   @id @default(cuid())
  ledgerId  String
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("CARD") // CARD | BANK | CASH | EMONEY
  brand     String?
  last4     String?
  color     String   @default("blue")
  icon      String   @default("card")
  createdAt DateTime @default(now())

  transactions  Transaction[]
  subscriptions Subscription[]
  recurringTransactions RecurringTransaction[]

  @@index([ledgerId])
}

// ─────────────────────────────────────────────
// 家計簿ドメイン
// ─────────────────────────────────────────────
model Category {
  id         String   @id @default(cuid())
  ledgerId   String
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  name       String
  type       String // INCOME | EXPENSE
  icon       String   @default("tag")
  color      String   @default("gray")
  parentId   String?
  parent     Category?  @relation("CatTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CatTree")
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())

  transactions Transaction[]
  budgets      Budget[]
  subscriptions Subscription[]
  recurringTransactions RecurringTransaction[]

  @@index([ledgerId, type])
}

model Transaction {
  id              String   @id @default(cuid())
  ledgerId        String
  ledger          Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  // 記録者が退会しても記録自体は帳簿に残す。Cascade のままだと共有帳簿で
  // 「他のメンバーが退会したら自分の家計簿から過去の記録が消える」ことになる。
  createdByUserId String?
  createdBy       User?    @relation("TxnCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  type            String // INCOME | EXPENSE
  amount          Int // 最小単位(JPY=円)
  currency        String   @default("JPY")
  occurredAt      DateTime
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  subscriptionId  String?
  subscription    Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  memo            String?
  createdAt       DateTime @default(now())

  @@index([ledgerId, occurredAt])
  @@index([ledgerId, categoryId])
  @@index([subscriptionId])
  @@index([recurringTransactionId])
}

// 繰り返し（定期）取引テンプレート。cron で nextRunAt 到来分を Transaction に自動生成。
model RecurringTransaction {
  id              String   @id @default(cuid())
  ledgerId        String
  ledger          Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?    @relation("RecurringCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  type            String // INCOME | EXPENSE
  amount          Int
  currency        String   @default("JPY")
  cycle           String   @default("MONTHLY") // MONTHLY | YEARLY | WEEKLY | QUARTERLY
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  memo            String?
  active          Boolean  @default(true)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions Transaction[]

  @@index([ledgerId, active])
  @@index([nextRunAt])
}

model Budget {
  id            String   @id @default(cuid())
  ledgerId      String
  ledger        Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isTotalBudget Boolean  @default(false)
  period        String   @default("MONTHLY") // MONTHLY | YEARLY
  amount        Int
  currency      String   @default("JPY")
  startMonth    DateTime
  createdAt     DateTime @default(now())

  // カテゴリ予算の一意性。全体予算(isTotalBudget=true, categoryId=null)が
  // 各帳簿で1件であることはアプリ層(upsert by lookup)で担保する。
  @@unique([ledgerId, categoryId, period, startMonth])
  @@index([ledgerId])
}

model Subscription {
  id                  String   @id @default(cuid())
  ledgerId            String
  ledger              Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ownerUserId         String?
  owner               User?    @relation("SubOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  name                String
  amount              Int
  currency            String   @default("JPY")
  cycle               String   @default("MONTHLY") // MONTHLY | YEARLY | WEEKLY | QUARTERLY
  status              String   @default("ACTIVE")  // ACTIVE | PAUSED | CANCELED | TRIAL
  nextRenewalAt       DateTime
  startedAt           DateTime?
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethodId     String?
  paymentMethod       PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  reminderDaysBefore  Int      @default(3)
  autoPostTransaction Boolean  @default(true)
  lastUsedAt          DateTime?
  lastReviewedAt      DateTime?
  trialEndsAt         DateTime? // status=TRIAL の終了予定日
  serviceKey          String?  // lib/service-catalog.ts のキー
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions  Transaction[]
  priceChanges  SubscriptionPriceChange[]

  @@index([ledgerId, nextRenewalAt])
  @@index([ledgerId, status])
}

// サブスクの価格改定履歴。amount 変更時に記録し、値上げ表示・履歴に用いる。
model SubscriptionPriceChange {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  oldAmount      Int
  newAmount      Int
  changedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, changedAt])
}

// ─────────────────────────────────────────────
// 貯金目標
// ─────────────────────────────────────────────
model Goal {
  id            String    @id @default(cuid())
  ledgerId      String
  ledger        Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Int
  currentAmount Int       @default(0)
  currency      String    @default("JPY")
  deadline      DateTime?
  color         String    @default("blue")
  icon          String    @default("target")
  // 自動積立（毎月）。amount と day が両方設定されると有効。
  autoContributionAmount Int?
  autoContributionDay    Int?      // 1-28
  nextAutoContributionAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contributions GoalContribution[]

  @@index([ledgerId])
  @@index([nextAutoContributionAt])
}

// 貯金目標の積立履歴。手動 / 自動の各積立を1行で記録。
model GoalContribution {
  id         String   @id @default(cuid())
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount     Int // 正=積立, 負=引き出し
  occurredAt DateTime @default(now())
  note       String?
  auto       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([goalId, occurredAt])
}

// ─────────────────────────────────────────────
// アプリ内通知
// ─────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerId  String?
  type      String // RENEWAL | SUMMARY | WASTE | SYSTEM | RECURRING | GOAL | BUDGET | PRICE_CHANGE | TRIAL_END
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// 収益化
// ─────────────────────────────────────────────
model BillingProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  tier                 String    @default("FREE") // FREE | PLUS | PRO
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  updatedAt            DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// 運用基盤
// ─────────────────────────────────────────────

/// 管理操作の証跡。tier 変更・権限付与・削除は取り返しがつかないため、
/// 誰が・いつ・何に・なぜ実行したかを必ず残す。
/// 対象が削除されても追えるよう、メール等はスナップショットで持つ。
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

/// バッチ実行の履歴。失敗しても誰も気づけない状態を避ける。
model CronRun {
  id        String   @id @default(cuid())
  job       String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  status    String   // RUNNING | SUCCESS | FAILED
  result    Json?
  error     String?
  trigger   String   // SCHEDULE | MANUAL
  actorId   String?

  @@index([job, startedAt])
  @@index([status, startedAt])
}

/// メール送信の記録。届いたかを後から追えるようにする。
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  kind      String   // REMINDER | CONTACT | VERIFY | RESET | BROADCAST
  status    String   // SENT | SKIPPED | FAILED
  error     String?
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@index([kind, createdAt])
  @@index([status, createdAt])
}

/// アプリケーションエラー。Sentry 未導入のため console にしか出ておらず、
/// Vercel のログを直接見ない限り気づけなかった。
/// fingerprint でまとめ、同じ不具合が何回起きているかを数える。
model ErrorEvent {
  id          String   @id @default(cuid())
  level       String   // ERROR | WARN
  message     String
  stack       String?
  context     Json?
  userId      String?
  path        String?
  fingerprint String
  count       Int      @default(1)
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([fingerprint])
  @@index([lastSeen])
}

/// リリースノート。572行のハードコードを置き換え、
/// 文言の修正にコード変更とデプロイを要らなくする。
model ReleaseNote {
  id         String   @id @default(cuid())
  version    String   @unique
  releasedAt DateTime
  title      String
  /// { h: 見出し, items: string[] } の配列
  sections   Json
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([releasedAt])
  @@index([published, releasedAt])
}

/// アプリ内に出す告知バナー（メンテナンス予告・障害情報）。
model AnnouncementBanner {
  id        String   @id @default(cuid())
  message   String
  href      String?
  tone      String   @default("INFO") // INFO | WARNING | CRITICAL
  startsAt  DateTime
  endsAt    DateTime
  /// 対象プラン。空なら全員。
  tiers     Json?
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}

/// 機能フラグ。段階公開のため、割合と対象プランを持つ。
model FeatureFlag {
  key         String   @id
  label       String
  description String?
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(0)
  tiers       Json?
  updatedAt   DateTime @updatedAt
}

/// システム設定。ハードコードされていた定数を管理画面から変えられるようにする。
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Stripe webhook の冪等化。同じ event.id を二度処理しない。
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  payload     Json?

  @@index([processedAt])
}
